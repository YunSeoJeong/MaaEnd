{
    "SwitchLanguageKoreanToChineseStart": {
        "desc": "登录界面：韩文切换为简体中文",
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "SwitchLanguageLoginAlreadyChinese",
            "[JumpBack]SceneWaitLoadingExit",
            "[JumpBack]WaitLoadingIcon",
            "[JumpBack]WaitLoadingText",
            "[JumpBack]WaitBlackScreen",
            "SwitchLanguageLoginOpenSettings"
        ]
    },
    "SwitchLanguageLoginAlreadyChinese": {
        "desc": "登录界面已是中文 Logo，跳过语言切换",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    330,
                    240,
                    600,
                    180
                ],
                "expected": [
                    "明日方舟：终末地",
                    "明日方舟终末地",
                    "终末地"
                ]
            }
        },
        "action": "DoNothing",
        "focus": {
            "Node.Action.Succeeded": "$task.SwitchLanguageKoreanToChinese.focus.already_chinese"
        }
    },
    "SwitchLanguageLoginOpenSettings": {
        "desc": "登录界面：点击设置按钮",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    {
                        "recognition": {
                            "type": "TemplateMatch",
                            "param": {
                                "roi": [
                                    0,
                                    -100,
                                    100,
                                    100
                                ],
                                "template": [
                                    "SceneManager/LoginExit.png"
                                ]
                            }
                        }
                    },
                    {
                        "recognition": {
                            "type": "TemplateMatch",
                            "param": {
                                "roi": [
                                    1070,
                                    350,
                                    210,
                                    90
                                ],
                                "template": "GameLanguage/KoreanLoginContinue.png",
                                "threshold": 0.76
                            }
                        }
                    }
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    1250,
                    82
                ]
            }
        },
        "post_wait_freezes": {
            "time": 300,
            "target": [
                260,
                80,
                760,
                520
            ],
            "timeout": 2000
        },
        "next": [
            "SwitchLanguageClickTopLanguageIconToChinese",
            "SwitchLanguageOpenLanguageTabToChinese",
            "SwitchLanguageWaitSettingsToChinese"
        ],
        "focus": {
            "Node.Action.Starting": "$task.SwitchLanguageKoreanToChinese.focus.open_settings"
        }
    },
    "SwitchLanguageChineseToKoreanStart": {
        "desc": "游戏内：中文切换为韩文",
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "SwitchLanguageChineseToKoreanOpenEscMenu",
