        ]
    },
    "SwitchLanguageChineseToKoreanOpenEscMenu": {
        "desc": "游戏内：确认在大世界后打开 Esc 菜单",
        "recognition": "And",
        "all_of": [
            "InWorld"
        ],
        "action": "ClickKey",
        "key": 27,
        "post_wait_freezes": {
            "time": 300,
            "target": [
                200,
                80,
                900,
                560
            ],
            "timeout": 2000
        },
        "next": [
            "SwitchLanguageEscOpenSettingsByOcr",
            "SwitchLanguageEscOpenSettingsByPosition"
        ]
    },
